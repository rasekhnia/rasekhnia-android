
plugins {
    id 'com.android.application'
}

android {
    namespace 'ir.rasekhnia.app'
    compileSdk 35

    defaultConfig {
        applicationId 'ir.rasekhnia.app'
        minSdk 23
        targetSdk 35
        versionCode 2
        versionName '1.2.0'
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }
}
